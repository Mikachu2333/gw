  <PropertyGroup Label="签名：强名称用 .snk，清单签名用证书存储里的指纹。两者都不入库，由 tools\make-dev-cert.ps1 生成">
    <!-- 强名称与清单签名是两套机制。ResolveKeySource 会把 AssemblyOriginatorKeyFile 导入
         传统强名称 CSP 容器，读不了 PowerShell 导出的无口令 pfx（MSB3325）；而 VSTO 的
         SignFile 只接受证书存储里的指纹。所以：强名称 → .snk；清单 → ManifestCertificateThumbprint。 -->
    <AssemblyOriginatorKeyFile>gw-strongname.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <SignAssembly>true</SignAssembly>
    <SignManifests>true</SignManifests>
  </PropertyGroup>
  <Target Name="ValidateSigningSettings">
    <Error Condition="'$(SignAssembly)' == 'true' And !Exists('$(AssemblyOriginatorKeyFile)')"
           Text="缺少强名称密钥 $(AssemblyOriginatorKeyFile)（不入库，属本机开发密钥）。请运行： powershell -ExecutionPolicy Bypass -File tools\make-dev-cert.ps1" />
    <Error Condition="'$(SignManifests)' == 'true' And '$(ManifestCertificateThumbprint)' == ''"
           Text="清单签名只能按证书存储中的指纹进行（VSTO 的 SignFile 不接受 pfx 路径）。请运行 tools\make-dev-cert.ps1，它会把指纹写入 gw_mika.csproj.user；若已有代码签名证书，可在该 .user 文件里手工设置 ManifestCertificateThumbprint。" />
  </Target>
