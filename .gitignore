# 构建产物
bin/
obj/
__pycache__/

# Visual Studio / MSBuild 本地状态
# .user 内含本机 Office/WPS 安装路径，属于个人环境，不应入库
.vs/
*.suo
*.user
*.cache

# NuGet 还原产物
packages/

# 代码签名证书、私钥与强名称密钥（均不得进版本库）
*.pfx
*.cer
*.pvk
*.key
*.snk

# VSTO / ClickOnce 发布输出
publish/
发布*/
*.application

# make.bat 的打包产物与安装包载荷（都是可再生的）
dist/

# 可选：随包携带的 VSTO 运行库（约 40 MB，不入库）
Installer/redist/

# WPS JS 加载项的依赖与打包产物（都可再生；package-lock.json 要入库以固定版本）
wps-js/node_modules/
wps-js/dist/
wps-js/vendor/
